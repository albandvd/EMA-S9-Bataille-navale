@page "/browse"
@inject GameStateStore Store
@inject NavigationManager Navigation
@implements IDisposable

<DsConsole>
    <TopScreen>
        <DsTopScreen>
            <h2>Salon public</h2>
            <DsErrorBanner Problem="Store.LastError" />
        </DsTopScreen>
    </TopScreen>
    <BottomScreen>
        <DsBottomScreen>
            <label class="ds-field">
                <span class="ds-field__label">Pseudo</span>
                <input class="ds-field__control" @bind="_playerName" placeholder="Joueur" />
            </label>

            @if (Store.OpenGames.Count == 0)
            {
                <p class="waiting-hint">Aucune partie en attente pour le moment.</p>
            }
            else
            {
                <ul class="open-games-list">
                    @foreach (var game in Store.OpenGames)
                    {
                        <li class="open-games-list__row">
                            <span>@game.HostName — @game.GridWidth×@game.GridHeight, @game.FleetPreset</span>
                            <DsButton Label="Rejoindre" OnClick="() => Join(game.GameId)" />
                        </li>
                    }
                </ul>
            }

            <DsButton Label="Rafraîchir" OnClick="Refresh" />
        </DsBottomScreen>
    </BottomScreen>
</DsConsole>

@code {
    private string _playerName = "Joueur";

    protected override async Task OnInitializedAsync()
    {
        Store.StateChanged += OnStoreChanged;
        await Refresh();
    }

    private Task Refresh() => Store.LoadOpenGamesAsync();

    private async Task Join(Guid gameId)
    {
        var request = new JoinGameRequest(_playerName, null, gameId, []);
        await Store.JoinGameAsync(request);

        if (Store.CurrentGame is { } game)
        {
            await Store.LoadFleetPresetAsync(game.FleetPreset);
            Navigation.NavigateTo("/deploy");
        }
    }

    private void OnStoreChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Store.StateChanged -= OnStoreChanged;
}
