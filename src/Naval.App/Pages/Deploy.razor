@page "/deploy"
@inject GameStateStore Store
@inject NavigationManager Navigation
@inject AudioService Audio
@implements IDisposable

<DsConsole>
    <TopScreen>
        <DsTopScreen>
            <h2>Votre grille</h2>
            @if (Store.CurrentGame is { } game)
            {
                <GridView Board="BuildDisplayBoard(game.Self.Board)"
                          OnCellClicked="HandleCellClicked"
                          OnCellHovered="HandleCellHovered"
                          PreviewCells="_previewCells"
                          PreviewValid="_previewValid"
                          ShipSprites="BuildShipSprites()" />
            }
        </DsTopScreen>
    </TopScreen>
    <BottomScreen>
        <DsBottomScreen>
            <DsErrorBanner Problem="Store.LastError" />
            @if (_placementError is not null)
            {
                <p class="ds-error-banner" role="alert">@_placementError</p>
            }
            @if (Store.CurrentGame is not null)
            {
                <ShipTray @ref="_shipTray" Fleet="_fleetToPlace"
                          OnSelectionChanged="HandleSelectionChanged"
                          OnOrientationChanged="HandleOrientationChanged" />
            }
            <DsButton Label="Valider la flotte" OnClick="ConfirmFleet" />
        </DsBottomScreen>
    </BottomScreen>
</DsConsole>

@code {
    private ShipTray? _shipTray;
    private readonly List<ShipPlacementDto> _placements = [];
    private IReadOnlyList<ShipStateDto> _fleetToPlace = [];
    private Dictionary<ShipType, int> _shipSizes = [];

    private ShipStateDto? _selectedShip;
    private Orientation _orientation = Orientation.Horizontal;
    private CoordinateDto? _hoveredCell;
    private string? _placementError;

    private HashSet<CoordinateDto>? _previewCells;
    private bool _previewValid;

    protected override void OnInitialized()
    {
        Store.StateChanged += OnStoreChanged;
        if (Store.CurrentGame is null)
        {
            Navigation.NavigateTo("/lobby");
            return;
        }

        _fleetToPlace = BuildFleetToPlace();
        _shipSizes = Store.FleetPreset?.Ships.ToDictionary(s => s.Type, s => s.Size)
            ?? [];
    }

    /// <summary>
    /// Étend le preset de flotte (un navire par type avec un décompte) en une liste plate de
    /// navires encore à placer, pour satisfaire le paramètre Fleet de ShipTray sans lui faire
    /// connaître la notion de preset.
    /// </summary>
    private IReadOnlyList<ShipStateDto> BuildFleetToPlace()
    {
        if (Store.FleetPreset is not { } preset)
        {
            return [];
        }

        var ships = new List<ShipStateDto>();
        foreach (var shipDefinition in preset.Ships)
        {
            for (var i = 0; i < shipDefinition.Count; i++)
            {
                ships.Add(new ShipStateDto($"{shipDefinition.Type}-{i}", shipDefinition.Type,
                    shipDefinition.Size, 0, false, null));
            }
        }

        return ships;
    }

    private void HandleSelectionChanged(ShipStateDto? ship)
    {
        _selectedShip = ship;
        _placementError = null;
        UpdatePreview();
    }

    private void HandleOrientationChanged(Orientation orientation)
    {
        _orientation = orientation;
        UpdatePreview();
    }

    private void HandleCellHovered(CoordinateDto? coordinate)
    {
        _hoveredCell = coordinate;
        UpdatePreview();
    }

    private void UpdatePreview()
    {
        if (_selectedShip is not { } ship || _hoveredCell is not { } origin || Store.CurrentGame is not { } game)
        {
            _previewCells = null;
            return;
        }

        var cells = ExpandCells(ship.Type, origin, _orientation).ToHashSet();
        _previewCells = cells;
        _previewValid = IsValidPlacement(cells, game.Self.Board.Width, game.Self.Board.Height);
    }

    private IEnumerable<CoordinateDto> ExpandCells(ShipType type, CoordinateDto origin, Orientation orientation)
    {
        var size = _shipSizes.GetValueOrDefault(type, 1);
        for (var i = 0; i < size; i++)
        {
            yield return orientation == Orientation.Horizontal
                ? new CoordinateDto(origin.X + i, origin.Y)
                : new CoordinateDto(origin.X, origin.Y + i);
        }
    }

    private bool IsValidPlacement(IReadOnlyCollection<CoordinateDto> cells, int width, int height)
    {
        var occupied = OccupiedCells();
        return cells.All(c => c.X >= 0 && c.X < width && c.Y >= 0 && c.Y < height)
            && cells.All(c => !occupied.Contains(c));
    }

    private HashSet<CoordinateDto> OccupiedCells() =>
        _placements.SelectMany(p => ExpandCells(p.Type, p.Origin, p.Orientation)).ToHashSet();

    /// <summary>Sprites des navires déjà posés, pour l'overlay décoratif de la grille.</summary>
    private IReadOnlyList<GridView.ShipSpriteOverlay> BuildShipSprites() =>
        _placements
            .Select(p => new GridView.ShipSpriteOverlay(
                p.Type, p.Origin, p.Orientation == Orientation.Vertical,
                _shipSizes.GetValueOrDefault(p.Type, 1), ""))
            .ToList();

    /// <summary>
    /// Superpose les navires déjà posés (encore locaux à la page) sur la grille renvoyée par le
    /// serveur, qui ne les connaît pas avant la validation de la flotte. Affichage uniquement :
    /// les placements ne partent au serveur qu'au moment de ConfirmFleet.
    /// </summary>
    private BoardViewDto BuildDisplayBoard(BoardViewDto board)
    {
        var occupied = OccupiedCells();
        if (occupied.Count == 0)
        {
            return board;
        }

        var rows = new List<string>(board.Rows.Count);
        for (var y = 0; y < board.Rows.Count; y++)
        {
            var chars = board.Rows[y].ToCharArray();
            for (var x = 0; x < chars.Length; x++)
            {
                if (occupied.Contains(new CoordinateDto(x, y)))
                {
                    chars[x] = 'S';
                }
            }

            rows.Add(new string(chars));
        }

        return board with { Rows = rows };
    }

    private async Task HandleCellClicked(CoordinateDto coordinate)
    {
        if (_selectedShip is not { } ship || Store.CurrentGame is not { } game)
        {
            return;
        }

        var cells = ExpandCells(ship.Type, coordinate, _orientation).ToList();
        if (!IsValidPlacement(cells, game.Self.Board.Width, game.Self.Board.Height))
        {
            _placementError = "Placement invalide : hors grille ou chevauchement d'un autre navire.";
            Audio.Play("deny");
            return;
        }

        Audio.Play("ui-select");
        _placements.Add(new ShipPlacementDto(ship.Type, coordinate, _orientation));
        _shipTray?.ConfirmPlacement();
        _selectedShip = null;
        _placementError = null;
        _previewCells = null;
    }

    private async Task ConfirmFleet()
    {
        await Store.PlaceFleetAsync(new PlaceFleetRequest(_placements));
        if (Store.CurrentGame?.Status == GameStatus.InProgress)
        {
            Navigation.NavigateTo("/battle");
        }
    }

    private void OnStoreChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Store.StateChanged -= OnStoreChanged;
}
