@page "/join"
@inject GameStateStore Store
@inject NavigationManager Navigation
@implements IDisposable

<DsConsole>
    <TopScreen>
        <DsTopScreen>
            <h2>Rejoindre par code</h2>
            <DsErrorBanner Problem="Store.LastError" />
        </DsTopScreen>
    </TopScreen>
    <BottomScreen>
        <DsBottomScreen>
            <div class="ds-form">
                <label class="ds-field">
                    <span class="ds-field__label">Pseudo</span>
                    <input class="ds-field__control" @bind="_playerName" placeholder="Joueur" />
                </label>
                <label class="ds-field">
                    <span class="ds-field__label">Code de partie</span>
                    <input class="ds-field__control" @bind="_joinCode" maxlength="6"
                           placeholder="K7M4XQ" style="text-transform: uppercase;" />
                </label>
                <DsButton Label="Rejoindre" OnClick="Join" />
            </div>
        </DsBottomScreen>
    </BottomScreen>
</DsConsole>

@code {
    private string _playerName = "Joueur";
    private string _joinCode = string.Empty;

    protected override void OnInitialized() => Store.StateChanged += OnStoreChanged;

    private async Task Join()
    {
        var request = new JoinGameRequest(_playerName, _joinCode.Trim().ToUpperInvariant(), null, []);
        await Store.JoinGameAsync(request);

        if (Store.CurrentGame is { } game)
        {
            await Store.LoadFleetPresetAsync(game.FleetPreset);
            Navigation.NavigateTo("/deploy");
        }
    }

    private void OnStoreChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Store.StateChanged -= OnStoreChanged;
}
