@page "/result"
@inject GameStateStore Store
@inject NavigationManager Navigation
@inject AudioService Audio

<DsConsole>
    <TopScreen>
        <DsTopScreen>
            @if (Store.CurrentGame is { WinnerId: { } winnerId } game)
            {
                var victory = winnerId == game.Self.PlayerId;
                <div class="result-banner @(victory ? "result-banner--win" : "result-banner--lose")">
                    <h2 class="result-banner__title">@(victory ? "Victoire" : "Défaite")</h2>
                    <p class="result-banner__sub">
                        @(victory ? "La flotte ennemie repose par le fond" : "Votre flotte a sombré")
                    </p>
                </div>
            }
        </DsTopScreen>
    </TopScreen>
    <BottomScreen>
        <DsBottomScreen>
            <div class="press-start">
                <span class="press-start__hint">— Fin de la partie —</span>
                <DsButton Label="Rejouer" OnClick="GoToLobby" />
            </div>
        </DsBottomScreen>
    </BottomScreen>
</DsConsole>

@code {
    protected override void OnInitialized()
    {
        if (Store.CurrentGame is null)
        {
            Navigation.NavigateTo("/lobby");
        }
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender && Store.CurrentGame is { WinnerId: { } winnerId } game)
        {
            Audio.Play(winnerId == game.Self.PlayerId ? "victory" : "defeat");
        }
    }

    private void GoToLobby() => Navigation.NavigateTo("/lobby");
}
