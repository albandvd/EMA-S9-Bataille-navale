@page "/battle"
@inject GameStateStore Store
@inject NavigationManager Navigation
@inject AudioService Audio
@implements IDisposable

<DsConsole>
    <TopScreen>
        <DsTopScreen>
            <h2>Grille adverse</h2>
            @if (Store.CurrentGame is { } game)
            {
                <GridView Board="game.Opponent.TargetBoard"
                          OnCellClicked="HandleFire"
                          ShipSprites="ToSprites(game.Opponent.SunkShips)" />
            }
        </DsTopScreen>
    </TopScreen>
    <BottomScreen>
        <DsBottomScreen>
            <DsErrorBanner Problem="Store.LastError" />

            @if (Store.CurrentGame is { Mode: not GameMode.SinglePlayer } onlineGame && !onlineGame.Opponent.IsConnected)
            {
                <p class="ds-error-banner" role="alert">
                    Adversaire déconnecté@(Store.OpponentGraceSecondsRemaining is { } g ? $" — {g}s pour revenir" : "").
                </p>
            }

            @if (Store.LastReceivedEmote is { } emote)
            {
                <p class="emote-toast" @onclick="Store.ClearLastReceivedEmote">@EmoteLabel(emote) — l'adversaire</p>
            }

            @if (Store.CurrentGame is { } current)
            {
                <h2>Votre grille</h2>
                <div class="battle-panel">
                    <GridView Board="current.Self.Board" ShipSprites="ToSprites(current.Self.Fleet)" />
                    <div class="battle-panel__side">
                        <EnergyGauge Energy="current.Self.Energy" />
                        @if (RemainingSeconds(current.TurnDeadlineUtc) is { } remaining)
                        {
                            <p class="turn-timer">Temps restant : @remaining s</p>
                        }
                        <ChargeMeter Charge="current.Opponent.Charge" />
                        @if (_pendingPower is { } pending)
                        {
                            <p class="power-bar__targeting" role="status">
                                Ciblez une case sur la grille adverse pour @pending.
                            </p>
                        }
                        <PowerBar Powers="current.Self.Powers" OnPowerActivated="HandlePower" />
                        @if (current.Mode != GameMode.SinglePlayer)
                        {
                            <div class="emote-picker">
                                @foreach (var emoteCode in EmoteCodes)
                                {
                                    <button class="emote-picker__button" title="@emoteCode" @onclick="() => SendEmote(emoteCode)">
                                        @EmoteLabel(emoteCode)
                                    </button>
                                }
                            </div>
                            <DsButton Label="Abandonner" OnClick="Forfeit" />
                        }
                        <EventLog Events="current.RecentEvents" />
                    </div>
                </div>
            }
        </DsBottomScreen>
    </BottomScreen>
</DsConsole>

@code {
    private static readonly EmoteCode[] EmoteCodes =
    [
        EmoteCode.GoodLuck, EmoteCode.WellPlayed, EmoteCode.Oops, EmoteCode.Thinking,
        EmoteCode.Taunt, EmoteCode.Sorry, EmoteCode.Gg, EmoteCode.Hurry
    ];

    private System.Timers.Timer? _tickTimer;

    protected override void OnInitialized()
    {
        Store.StateChanged += OnStoreChanged;
        Store.ShotResolved += OnShotResolved;

        if (Store.CurrentGame is null)
        {
            Navigation.NavigateTo("/lobby");
            return;
        }

        // Force un ré-affichage chaque seconde pour que le compte à rebours du timer de tour
        // (E-07) avance même sans nouvel événement serveur.
        _tickTimer = new System.Timers.Timer(1000);
        _tickTimer.Elapsed += (_, _) => InvokeAsync(StateHasChanged);
        _tickTimer.Start();
    }

    private PowerId? _pendingPower;

    private async Task HandleFire(CoordinateDto target)
    {
        if (_pendingPower is { } powerId)
        {
            await ActivatePowerOn(powerId, target);
            return;
        }

        Audio.Play("fire");
        await Store.FireAsync(target);
    }

    private async Task ActivatePowerOn(PowerId powerId, CoordinateDto target)
    {
        _pendingPower = null;
        Audio.Play("sonar-ping");
        await Store.UsePowerAsync(powerId, new PowerTargetDto(target, null, null, null, null));
    }

    /// <summary>
    /// Un seul point d'écoute pour le son de résultat de tir, qu'il vienne de ce joueur ou de
    /// l'adversaire (poussé en temps réel par le hub) : le son décrit ce que le serveur a
    /// tranché, jamais une règle de jeu recalculée côté client.
    /// </summary>
    private void OnShotResolved(ShotResultDto result)
    {
        if (Store.LastError is not null)
        {
            Audio.Play("deny");
            return;
        }

        Audio.Play(result.Outcome switch
        {
            ShotOutcome.Sunk => "sunk",
            ShotOutcome.Hit => "explosion",
            _ => "splash"
        });
    }

    private void HandlePower(PowerId id)
    {
        // TODO(E-16, futur pouvoir TargetKind.None) : cette méthode arme systématiquement
        // _pendingPower et attend un clic sur la grille adverse. C'est correct pour Sonar
        // (TargetKind.Area), mais un futur pouvoir sans cible (TargetKind.None, ex.
        // RadioIntercept) resterait bloqué en attente d'un clic qu'il n'utilise pas — à
        // traiter quand un tel pouvoir sera implémenté.
        _pendingPower = id;
    }

    private Task SendEmote(EmoteCode code) => Store.SendEmoteAsync(code);

    private async Task Forfeit() => await Store.ForfeitAsync();

    private static int? RemainingSeconds(DateTimeOffset? deadline) =>
        deadline is { } d ? Math.Max(0, (int)(d - DateTimeOffset.UtcNow).TotalSeconds) : null;

    private static string EmoteLabel(EmoteCode code) => code switch
    {
        EmoteCode.GoodLuck => "🍀 Bonne chance",
        EmoteCode.WellPlayed => "👏 Bien joué",
        EmoteCode.Oops => "😬 Oups",
        EmoteCode.Thinking => "🤔 Réflexion",
        EmoteCode.Taunt => "😏 Raillerie",
        EmoteCode.Sorry => "🙏 Désolé",
        EmoteCode.Gg => "🤝 GG",
        EmoteCode.Hurry => "⏱️ Dépêche",
        _ => code.ToString()
    };

    /// <summary>
    /// Convertit des navires en sprites de grille. Ne produit un sprite que si le serveur a
    /// fourni les cases (sa propre flotte, ou les navires adverses déjà coulés) : aucune
    /// position non révélée ne transite par ici.
    /// </summary>
    private static IReadOnlyList<GridView.ShipSpriteOverlay> ToSprites(IReadOnlyList<ShipStateDto> ships)
    {
        var sprites = new List<GridView.ShipSpriteOverlay>();
        foreach (var ship in ships)
        {
            if (ship.Cells is not { Count: > 0 } cells)
            {
                continue;
            }

            var minX = cells.Min(c => c.X);
            var minY = cells.Min(c => c.Y);
            var vertical = cells.Count > 1 && cells.All(c => c.X == minX);
            var variant = ship.IsSunk ? "-sunk" : ship.Hits > 0 ? "-damaged" : "";
            sprites.Add(new GridView.ShipSpriteOverlay(
                ship.Type, new CoordinateDto(minX, minY), vertical, ship.Size, variant));
        }

        return sprites;
    }

    private void OnStoreChanged()
    {
        if (Store.CurrentGame?.Status is GameStatus.Finished or GameStatus.Abandoned)
        {
            Navigation.NavigateTo("/result");
            return;
        }

        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Store.StateChanged -= OnStoreChanged;
        Store.ShotResolved -= OnShotResolved;
        _tickTimer?.Stop();
        _tickTimer?.Dispose();
    }
}
