<div class="ship-tray">
    @foreach (var ship in Fleet.Where(s => !_placedIds.Contains(s.Id)))
    {
        <div class="ship-tray__item @(ship == _selected ? "ship-tray__item--selected" : "")"
             @onclick="() => Select(ship)">
            @ship.Type (@ship.Size)
        </div>
    }
    <button class="ship-tray__rotate ds-button" @onclick="ToggleOrientation">
        Orientation : @_orientation
    </button>
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<ShipStateDto> Fleet { get; set; } = [];
    [Parameter] public EventCallback<ShipStateDto?> OnSelectionChanged { get; set; }
    [Parameter] public EventCallback<Orientation> OnOrientationChanged { get; set; }

    private ShipStateDto? _selected;
    private Orientation _orientation = Orientation.Horizontal;
    private readonly HashSet<string> _placedIds = [];

    private async Task Select(ShipStateDto ship)
    {
        _selected = ship;
        if (OnSelectionChanged.HasDelegate)
        {
            await OnSelectionChanged.InvokeAsync(_selected);
        }
    }

    private async Task ToggleOrientation()
    {
        _orientation = _orientation == Orientation.Horizontal ? Orientation.Vertical : Orientation.Horizontal;
        if (OnOrientationChanged.HasDelegate)
        {
            await OnOrientationChanged.InvokeAsync(_orientation);
        }
    }

    /// <summary>
    /// Confirme le placement du navire actuellement sélectionné : la validation géométrique
    /// (bornes, chevauchement) est faite par la page appelante, qui seule connaît la grille et
    /// les autres navires déjà posés.
    /// </summary>
    public void ConfirmPlacement()
    {
        if (_selected is null)
        {
            return;
        }

        _placedIds.Add(_selected.Id);
        _selected = null;
    }
}
