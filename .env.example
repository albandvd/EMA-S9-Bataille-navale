# Copiez en .env pour surcharger les valeurs par défaut de docker-compose.yml.
# Les deux variables *_PUBLIC_URL doivent être des adresses atteignables par le NAVIGATEUR
# du joueur (pas des noms de service Docker) — voir le commentaire en tête de docker-compose.yml.

# URL publique de Naval.Api, telle que le navigateur doit la contacter.
API_PUBLIC_URL=http://localhost:5119/

# Origine publique de Naval.App, autorisée par la policy CORS de Naval.Api.
APP_PUBLIC_URL=http://localhost:8080

# Ports publiés sur l'hôte Docker.
API_PUBLISHED_PORT=5119
APP_PUBLISHED_PORT=8080
